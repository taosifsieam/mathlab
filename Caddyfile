# STREAM_HOST is e.g. stream.yourdomain.com (an A record pointing to this VPS)
{$STREAM_HOST} {
	encode gzip
	# students' HLS requests
	handle /live/* {
		reverse_proxy 127.0.0.1:8888
	}
	# recordings
	handle /get* {
		reverse_proxy 127.0.0.1:9996
	}
	handle /list* {
		reverse_proxy 127.0.0.1:9996
	}
	respond 404
}
